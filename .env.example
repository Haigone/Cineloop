# Leave DATABASE_URL unset to run on the built-in in-memory demo data.
# Set it to use PostgreSQL, then run: npm run db:migrate && npm run db:seed
# DATABASE_URL=postgres://cineloop:cineloop@localhost:5432/cineloop

# Optional: TMDB read access token for the catalog (not required for the demo).
# TMDB_READ_TOKEN=

# Optional: "Continua con Google / Discord". Each button appears only when both its values are set.
# Callback URLs to register with the providers: <site>/api/auth/google/callback and <site>/api/auth/discord/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Optional: the site's public address, if it differs from what the request says (e.g. https://cineloop.example)
# APP_URL=
