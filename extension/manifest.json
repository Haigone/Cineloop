{
  "manifest_version": 3,
  "name": "CineLoop",
  "short_name": "CineLoop",
  "version": "0.5.2",
  "description": "Aggiorna CineLoop mentre guardi Netflix, AnimeUnity o StreamingCommunity: rileva serie, episodio e punto raggiunto.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "CineLoop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://www.netflix.com/*",
    "https://www.animeunity.so/*",
    "https://www.streaming-community.how/*"
  ]
}
